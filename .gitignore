# Runtime data (SQLite index, cover cache, and now the library list itself)
/data/

# Local test fixtures generated during development — also the default
# TAGBOX_MEDIA_ROOT fallback for local dev.
/dev-library/

# Backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/**/*.egg-info/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Editors / OS
.DS_Store
*.swp
.vscode/
.idea/

# Env files that might carry secrets
.env
.env.*
!.env.example
